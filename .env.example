NODE_ENV=production
PORT=10000
QR_PUBLIC=false
WHATSAPP_QR_BOOTSTRAP=false
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# These identity values are required in the deployment environment and are never committed.
BOT_PHONE=
BOT_PHONE_INTL=
WHATSAPP_DISPLAY_NAME=Aljarah
# The exact official group allowlist; set it only in the deployment environment.
WHATSAPP_GROUP_ID=
WHATSAPP_GROUP_NAME=قروب Aljarah الرسمي
WHATSAPP_GROUP_INVITE_URL=
DATA_DIR=/app/data
AUTH_PATH=/app/data/.wwebjs_auth
BAILEYS_AUTH_PATH=/app/data/.baileys_auth
BAILEYS_ENABLED=false
CORS_ORIGIN=
RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=120
ADMIN_TOKEN=generate-with-openssl-rand-base64-32
JWT_SECRET=generate-a-different-long-random-secret
ADMIN_USERNAME=Aljarah
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
CAPTAIN_MIN_BALANCE_CENTS=-200
# The fare after "السعر" is external and is never credited to the executor.
COMPANY_RATE_BPS=300
PRODUCER_RATE_BPS=1200
SPECIAL_ORDER_RATE_BPS=1200
COMPANY_FROM_PRODUCER_RATE_BPS=300
WHATSAPP_INIT_TIMEOUT_MS=180000
WHATSAPP_PROTOCOL_TIMEOUT_MS=300000
WHATSAPP_RECONNECT_BASE_DELAY_MS=5000
WHATSAPP_RECONNECT_MAX_DELAY_MS=120000
WHATSAPP_RECONNECT_MAX_ATTEMPTS=20
QR_RATE_LIMIT_MAX=3000
