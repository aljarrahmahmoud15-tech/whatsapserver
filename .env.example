# Clean/client service template only. Never copy a live .env between services.
NODE_ENV=production
PORT=10000
CLEAN_INSTANCE=true
CLEAN_OUTBOUND_SENDS_ENABLED=false
QR_PUBLIC=false
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Set these only to this service's own WhatsApp identity and group.
BOT_PHONE=
BOT_PHONE_INTL=
WHATSAPP_GROUP_ID=
WHATSAPP_GROUP_NAME=
GROUP_SETUP_OWNER_PHONES=
PUBLIC_BASE_URL=

# Each service must use its own persistent storage and LocalAuth paths.
DATA_DIR=/app/data
RENDER_DATA_DIR=/app/data
AUTH_PATH=/app/data/.wwebjs_auth
BAILEYS_AUTH_PATH=/app/data/.baileys_auth
BAILEYS_ENABLED=false

# Create unique secrets per service; never reuse values from Server 2.
ADMIN_TOKEN=
JWT_SECRET=
ADMIN_PASSWORD=
CAPTAIN_PASSWORD=

CORS_ORIGIN=
RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=120
WHATSAPP_INIT_TIMEOUT_MS=180000
WHATSAPP_PROTOCOL_TIMEOUT_MS=300000
WHATSAPP_RECONNECT_BASE_DELAY_MS=5000
WHATSAPP_RECONNECT_MAX_DELAY_MS=120000
WHATSAPP_RECONNECT_MAX_ATTEMPTS=20
QR_RATE_LIMIT_MAX=3000
CAPTAIN_MIN_BALANCE_CENTS=-200
COMPANY_RATE_BPS=300
PRODUCER_RATE_BPS=1200
SPECIAL_ORDER_RATE_BPS=1200
COMPANY_FROM_PRODUCER_RATE_BPS=300
