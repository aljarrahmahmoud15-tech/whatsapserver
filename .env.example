NODE_ENV=production
PORT=10000
QR_PUBLIC=false
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
BOT_PHONE=0779110123
BOT_PHONE_INTL=962779110123
WHATSAPP_DISPLAY_NAME=Bot
# Server 2 allowlist: the only WhatsApp group this service may read or send to.
WHATSAPP_GROUP_ID=120363426604560611@g.us
WHATSAPP_GROUP_NAME=العزوة — شبكة التشغيل الرسمية
DATA_DIR=/app/data
AUTH_PATH=/app/data/.wwebjs_auth
BAILEYS_AUTH_PATH=/app/data/.baileys_auth
BAILEYS_ENABLED=false
CORS_ORIGIN=
RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=120
ADMIN_TOKEN=generate-with-openssl-rand-base64-32
JWT_SECRET=generate-a-different-long-random-secret
ADMIN_USERNAME=company
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
